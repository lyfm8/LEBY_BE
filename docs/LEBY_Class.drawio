        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;background&#39;: &#39;#ffffff&#39;,\n    &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#000000&#39;,\n    &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n    &#39;lineColor&#39;: &#39;#000000&#39;,\n    &#39;secondaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;tertiaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;classText&#39;: &#39;#000000&#39;,\n    &#39;edgeLabelBackground&#39;: &#39;#ffffff&#39;,\n    &#39;relationLabelBackground&#39;: &#39;#ffffff&#39;,\n    &#39;relationLabelColor&#39;: &#39;#000000&#39;,\n    &#39;labelBackgroundColor&#39;: &#39;#ffffff&#39;,\n    &#39;labelTextColor&#39;: &#39;#000000&#39;,\n    &#39;tertiaryTextColor&#39;: &#39;#000000&#39;,\n    &#39;noteBkgColor&#39;: &#39;#ffffff&#39;,\n    &#39;noteTextColor&#39;: &#39;#000000&#39;,\n    &#39;noteBorderColor&#39;: &#39;#000000&#39;\n  },\n  &#39;flowchart&#39;: { &#39;curve&#39;: &#39;linear&#39; },\n  &#39;class&#39;: { &#39;curve&#39;: &#39;linear&#39; }\n}}%%\nclassDiagram\n    direction TB\n\n%% ============================\n%% ENUMERATIONS\n%% ============================\nclass RoleType {\n    &lt;&lt;enumeration&gt;&gt;\n    STUDENT\n    ADMIN\n}\n\nclass LessonStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    LOCKED\n    UNLOCKED\n    COMPLETED\n}\n\nclass LevelStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    LOCKED\n    IN_PROGRESS\n    COMPLETED\n}\n\nclass VideoStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    PUBLIC\n    PRIVATE\n}\n\nclass ExerciseType {\n    &lt;&lt;enumeration&gt;&gt;\n    MULTIPLE_CHOICE\n    FILL_BLANK\n    MATCHING\n}\n\nclass QuestionType {\n    &lt;&lt;enumeration&gt;&gt;\n    SINGLE_CHOICE\n    MULTIPLE_CHOICE\n}\n\nclass PlacementResult {\n    &lt;&lt;enumeration&gt;&gt;\n    BEGINNER\n    ELEMENTARY\n    PRE_INTERMEDIATE\n    INTERMEDIATE\n}\n\nclass TestStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    IN_PROGRESS\n    COMPLETED\n}\n\n%% ============================\n%% AUTHENTICATION\n%% ============================\nclass Role {\n    -id: Long\n    -type: RoleType\n}\n\nclass User {\n    -id: Long\n    -username: String\n    -password: String\n    -email: String\n    -fullName: String\n    -avatar: String\n    -status: Boolean\n    -createdAt: Date\n    -updatedAt: Date\n    +register()\n    +login()\n    +logout()\n    +validateCredential()\n}\n\nUser \&quot;0..*\&quot; -- \&quot;1\&quot; Role : has\n\n%% ============================\n%% LEARNING\n%% ============================\nclass LearningPath {\n    -id: Long\n    -name: String\n    -description: String\n    -createdAt: Date\n    +viewLearningPath()\n}\n\nclass Level {\n    -id: Long\n    -name: String\n    -orderIndex: int\n    -status: LevelStatus\n    +viewLevel()\n    +unlockNextLevel()\n}\n\nclass Course {\n    -id: Long\n    -title: String\n    -description: String\n    -orderIndex: int\n    -status: Boolean\n    +manageCourse()\n}\n\nclass Lesson {\n    -id: Long\n    -title: String\n    -description: String\n    -orderIndex: int\n    -status: LessonStatus\n    +viewLesson()\n    +manageLesson()\n}\n\nclass Video {\n    -id: Long\n    -title: String\n    -url: String\n    -duration: int\n    -status: VideoStatus\n    +watchVideo()\n    +manageVideo()\n}\n\nclass Exercise {\n    -id: Long\n    -title: String\n    -type: ExerciseType\n    -instruction: String\n    +startExercise()\n    +submitExercise()\n    +manageExercise()\n}\n\nclass Question {\n    -id: Long\n    -content: String\n    -type: QuestionType\n    -options: String\n    -correctAnswer: String\n    +manageQuestion()\n}\n\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; LearningPath : follows\nLearningPath \&quot;1\&quot; o-- \&quot;1..*\&quot; Level : contains\nLevel \&quot;1\&quot; *-- \&quot;1..*\&quot; Course : contains\nCourse \&quot;1\&quot; *-- \&quot;1..*\&quot; Lesson : contains\nLesson \&quot;1\&quot; *-- \&quot;0..*\&quot; Video : contains\nLesson \&quot;1\&quot; *-- \&quot;0..*\&quot; Exercise : contains\nExercise \&quot;1\&quot; *-- \&quot;1..*\&quot; Question : contains\n\n%% ============================\n%% TESTING\n%% ============================\nclass Test {\n    &lt;&lt;abstract&gt;&gt;\n    -id: Long\n    -startDate: Date\n    -endDate: Date\n    -status: TestStatus\n    +startTest()\n    +submitTest()\n    +calculateScore()\n}\n\nclass PlacementTest {\n    -score: int\n    -result: PlacementResult\n    +determineLevel()\n}\n\nclass LevelTest {\n    -score: int\n    -passScore: int\n    +determineLevel()\n}\n\nclass Submission {\n    &lt;&lt;abstract&gt;&gt;\n    -id: Long\n    -score: int\n    -submittedAt: Date\n    +calculateScore()\n}\n\nclass ExerciseResult {\n    -isCorrect: Boolean\n    -answer: String\n    +viewExerciseResult()\n}\n\nclass LevelTestResult {\n    -passed: Boolean\n    +viewLevelTestResult()\n}\n\nTest &lt;|-- PlacementTest\nTest &lt;|-- LevelTest\nSubmission &lt;|-- ExerciseResult\nSubmission &lt;|-- LevelTestResult\n\nPlacementTest \&quot;1\&quot; *-- \&quot;1..*\&quot; Question : includes\nLevelTest \&quot;1\&quot; *-- \&quot;1..*\&quot; Question : includes\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; PlacementTest : takes\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; LevelTest : takes\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; ExerciseResult : owns\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; LevelTestResult : owns\n\nExercise \&quot;1\&quot; -- \&quot;0..*\&quot; ExerciseResult : produces\nLevelTest \&quot;1\&quot; -- \&quot;0..*\&quot; LevelTestResult : produces\nLevel \&quot;1\&quot; -- \&quot;0..1\&quot; LevelTest : has&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2G2OkuZ4bXZKdtsq2zRS-205">
